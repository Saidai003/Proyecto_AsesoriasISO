# Copia este archivo a .env en la raíz del proyecto y ajusta los valores.
# Docker Compose lee estas variables automáticamente.

# development | production
NODE_ENV=development

# Credenciales MySQL (deben coincidir con docker-compose.yml)
MYSQL_ROOT_PASSWORD=rootpassword
DB_PASSWORD=change_me

# Seguridad (cambiar en producción)
JWT_SECRET=cambia_esto_en_produccion
SEED_SECRET=cambia_esto_en_produccion
