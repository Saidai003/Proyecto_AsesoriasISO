# Ejemplo de variables de entorno para la conexión MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=proyecto_iso
PORT=3000
JWT_SECRET=algún_secreto_fuerte
SEED_SECRET=dev_seed_secret
NODE_ENV=development

# Google Drive: carpeta compartida en Drive (ID de la URL)
GOOGLE_DRIVE_FOLDER_ID=
# Opcional: forzar nombre de subcarpeta de entorno (por defecto Development | Production según NODE_ENV)
# GOOGLE_DRIVE_ENV_FOLDER=Production